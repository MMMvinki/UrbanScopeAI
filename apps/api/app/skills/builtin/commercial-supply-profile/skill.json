{
  "schema_version": "1.0",
  "kind": "executable",
  "id": "commercial-supply-profile",
  "name": "商业供给格局",
  "description": "使用固定候选研究范围和商业原始专题点源，在 EPSG:32650 中生成全局锚定 100m 网格，重算 isdelete=0 有效商业点数量、密度与正密度中位数阈值，划分高供给、低供给两类，输出可上图的真实结果、统计和证据。缺文件、字段、CRS 或有效样本时明确失败，不使用演示兜底。",
  "scope": "builtin",
  "version": "0.1.0",
  "revision": 1,
  "status": "validated",
  "entry": "scripts/main.py",
  "runtime": {
    "language": "python",
    "python": null,
    "dependencies": [
      "geopandas",
      "numpy",
      "pandas",
      "pyproj",
      "shapely"
    ]
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "study_area_path": {
        "type": "string",
        "description": "研究范围文件；默认 docs/workstreams/analysis-foundation/data/candidate_lohas_study_area.geojson"
      },
      "commercial_path": {
        "type": "string",
        "description": "商业点源；默认 ../04-乐活大道GIS数据/00-原始数据/专项资源/商业资源/商业资源Export_Output_46.shp"
      },
      "study_area_crs": {
        "type": "string",
        "default": "EPSG:4326",
        "description": "研究范围预期 CRS；必须与文件元数据一致"
      },
      "commercial_crs": {
        "type": "string",
        "default": "EPSG:4547",
        "description": "商业点预期 CRS；必须与文件元数据一致"
      },
      "cell_size_m": {
        "type": "integer",
        "const": 100,
        "default": 100,
        "description": "固定 100m 稳定网格；其他值会失败"
      },
      "output_layer_id": {
        "type": "string",
        "description": "可选结果图层 id；默认 commercial_supply_profile_100m"
      }
    },
    "required": []
  },
  "output_schema": {
    "type": "object",
    "required": ["success", "summary", "layer_id", "stats", "evidence", "layers"]
  },
  "validation": {
    "protocol_ok": true,
    "syntax_ok": true,
    "direct_param_access": [],
    "warnings": [],
    "errors": []
  },
  "provenance": {
    "promoted_from": null,
    "created_by": "platform",
    "run_count": 0,
    "last_run_at": null
  },
  "created_at": "2026-09-02T00:00:00",
  "updated_at": "2026-09-02T00:00:00"
}
